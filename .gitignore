/target

# Generated ATP problem files. Reconstruct with:
#   python3 scripts/sample_control_pairs.py
#   ./target/release/pm tptp out/atp/samples/<sample>.txt out/tptp_<name>
#   ./target/release/pm ladr out/atp/samples/<sample>.txt out/ladr_<name>
#   PM_GROUND=1 ./target/release/pm smt2 out/atp/samples/<sample>.txt out/smt_<n> <n>
# The sample pair lists and the run results are tracked; the problem files
# themselves are not, since they are a pure function of the two.
/out/tptp_*/
/out/ladr_*/
/out/smt_*/

# Decompressed copies of files stored gzipped.
/data/etp/implications.bits
/data/etp/eq_size5.txt
/out/corpus_signatures.bin

# Drafts of messages to other projects. They go public when sent, not before.
/outreach/

# Blog drafts. Local until published somewhere deliberate.
/writing/

# Python bytecode
__pycache__/
*.pyc

# Draft paper. Goes public via Zenodo when submitted, not before.
/paper/

.DS_Store
